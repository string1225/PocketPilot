{
  "name": "@pocketpilot/android-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b && pnpm bundle",
    "bundle": "esbuild src/global.ts --bundle --format=iife --target=chrome61 --minify --outfile=dist/pocketpilot-runtime.js",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@pocketpilot/agent-core": "workspace:*",
    "@pocketpilot/providers": "workspace:*",
    "@pocketpilot/tool-runtime": "workspace:*",
    "typescript": "^5.7.3"
  }
}
